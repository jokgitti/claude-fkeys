<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lucagaleazzi.fkeys</string>
    <key>ProgramArguments</key>
    <array>
        <string>@HOME@/.claude/bin/fkeysd</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>@HOME@/.claude/fkeys.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/.claude/fkeys.log</string>
</dict>
</plist>
